{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"},
    "time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
    "dbn": {"type": "string", "pattern": "^\\d{2}[KMQRX]\\d{3}$"},
    "url": {"type": "string", "pattern": "^https?://"},
    "pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "provenance": {
      "type": "object",
      "required": ["source", "as_of"],
      "properties": {
        "source": {"type": "string"},
        "as_of": {"$ref": "#/$defs/date"},
        "period": {"type": "string", "description": "School year the numbers describe, for example 2024-25"}
      },
      "additionalProperties": false
    }
  }
}

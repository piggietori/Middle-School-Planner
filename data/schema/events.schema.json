{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Open houses and key admissions dates",
  "type": "object",
  "required": ["schema_version", "cycle", "retired_ids", "events"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "cycle": {"type": "string", "pattern": "^\\d{4}$"},
    "retired_ids": {"type": "array", "items": {"type": "string"}, "description": "Event IDs removed on purpose. Plans may still reference them."},
    "events": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/open"}, {"$ref": "#/$defs/key"}]}}
  },
  "additionalProperties": false,
  "$defs": {
    "was": {
      "type": "object", "required": ["date"],
      "description": "The date and time before a change, so families who planned around it can be told",
      "properties": {"date": {"$ref": "common.schema.json#/$defs/date"}, "start": {"$ref": "common.schema.json#/$defs/time"}, "end": {"$ref": "common.schema.json#/$defs/time"}},
      "additionalProperties": false
    },
    "open": {
      "type": "object",
      "required": ["id", "kind", "dbn", "date", "start", "source", "as_of"],
      "properties": {
        "id": {"type": "string", "pattern": "^oh-\\d{2}[KMQRX]\\d{3}-\\d{4}-\\d{2}-\\d{2}-\\d{4}$"},
        "kind": {"const": "open"},
        "dbn": {"$ref": "common.schema.json#/$defs/dbn"},
        "date": {"$ref": "common.schema.json#/$defs/date"},
        "start": {"$ref": "common.schema.json#/$defs/time"},
        "end": {"$ref": "common.schema.json#/$defs/time"},
        "note": {"type": "string"},
        "was": {"$ref": "#/$defs/was"},
        "source": {"type": "string"},
        "as_of": {"$ref": "common.schema.json#/$defs/date"}
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": ["id", "kind", "date", "title", "text", "source", "as_of"],
      "properties": {
        "id": {"type": "string", "pattern": "^k-[a-z0-9-]+$"},
        "kind": {"const": "key"},
        "date": {"$ref": "common.schema.json#/$defs/date"},
        "start": {"$ref": "common.schema.json#/$defs/time"},
        "end": {"$ref": "common.schema.json#/$defs/time"},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "link": {"$ref": "common.schema.json#/$defs/url"},
        "flyer": {"$ref": "common.schema.json#/$defs/url"},
        "was": {"$ref": "#/$defs/was"},
        "source": {"type": "string"},
        "as_of": {"$ref": "common.schema.json#/$defs/date"}
      },
      "additionalProperties": false
    }
  }
}

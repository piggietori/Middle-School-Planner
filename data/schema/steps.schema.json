{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steps.schema.json",
  "title": "Application steps",
  "type": "object",
  "required": ["schema_version", "cycle", "steps"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "cycle": {"type": "string", "pattern": "^\\d{4}$"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "t", "d"],
        "properties": {
          "id": {"type": "string", "pattern": "^s\\d+[a-z]?$"},
          "t": {"type": "string", "description": "Title"},
          "d": {"type": "string", "description": "What to do"},
          "tab": {"enum": ["home", "dates", "find", "list"]},
          "link": {"$ref": "common.schema.json#/$defs/url"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
